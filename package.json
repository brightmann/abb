{
  "name": "next-template",
  "description": "Next.js Starter Template with TypeScript, Tailwindcss, Shadcn-ui, ESLint, and Prettier",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "mdx": "node scripts/compile-mdx.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "preview": "next build && next start",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write  ./src/**/*.{ts,tsx,js,jsx,json,md}",
    "format:check": "prettier --check ./src/**/*.{ts,tsx,js,jsx,json,md}",
    "ci-check": "contentlayer build && pnpm lint && pnpm typecheck && pnpm format:check",
    "fix-all": "pnpm format && pnpm lint:fix"
  },
  "dependencies": {
    "@ducanh2912/next-pwa": "^9.2.0",
    "@radix-ui/react-alert-dialog": "^1.0.4",
    "@radix-ui/react-avatar": "^1.0.3",
    "@radix-ui/react-dialog": "^1.0.4",
    "@radix-ui/react-popover": "^1.0.6",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-tooltip": "^1.0.6",
    "@vercel/og": "0.5.8",
    "class-variance-authority": "^0.6.0",
    "clsx": "^1.2.1",
    "contentlayer": "^0.3.3",
    "lucide-react": "^0.248.0",
    "next": "14.2.35",
    "next-contentlayer": "^0.3.3",
    "next-pwa": "^5.6.0",
    "next-themes": "^0.2.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "rehype-autolink-headings": "^6.1.1",
    "rehype-pretty-code": "^0.10.0",
    "rehype-slug": "^5.1.0",
    "remark": "^14.0.3",
    "remark-gfm": "^3.0.1",
    "sharp": "^0.32.6",
    "shiki": "^0.14.7"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.0.2",
    "@opennextjs/cloudflare": "1.15.0",
    "@tailwindcss/typography": "^0.5.9",
    "@types/node": "20.3.1",
    "@types/react": "18.2.13",
    "@types/react-dom": "18.2.6",
    "@typescript-eslint/parser": "^5.60.0",
    "autoprefixer": "10.4.19",
    "eslint": "8.43.0",
    "eslint-config-next": "14.2.35",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-tailwindcss": "^3.12.1",
    "postcss": "8.4.31",
    "prettier": "^2.8.8",
    "prettier-plugin-tailwindcss": "^0.3.0",
    "tailwind-merge": "^1.13.2",
    "tailwindcss": "3.3.2",
    "tailwindcss-animate": "^1.0.6",
    "typescript": "5.1.3",
    "wrangler": "^4.142.0"
  }
}
